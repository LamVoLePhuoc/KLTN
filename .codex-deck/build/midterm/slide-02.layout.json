    {
      "order": 2,
      "kind": "table",
      "scope": "slide",
      "id": "tb/y5wjy587",
      "editable": true,
      "name": "Table 10",
      "position": {
        "left": 142.12,
        "top": 273.19,
        "width": 1587.76,
        "height": 301.21
      },
      "text": "Công việc | Nội dung thực hiện | Trạng thái\nKhảo sát đề tài nghiên cứu | Khảo sát bài toán PPG-BP, mô hình tăng tốc CNN-LSTM và hướng triển khai trên FPGA/SoC | Đã hoàn thành\nXây dựng mô hình tham chiếu | Huấn luyện mô hình CNN-LSTM trên phần mềm, tạo trọng số và output tham chiếu | Đã hoàn thành\n\nHiện thực RTL | Thiết kế các khối Convolution, Pooling, LSTM, Fully Connected và Controller | Đã hoàn thành\n\nMô phỏng kiểm chứng | Kiểm chứng theo từng lớp và kiểm chứng toàn hệ thống | Đã hoàn thành\nTích hợp SoC | Tích hợp bộ tăng tốc vào hệ thống SoC KV260 qua giao tiếp AXI | Đã hoàn thành\n\nĐánh giá và tối ưu | Đánh giá kết quả thực thi trên KV260, tối ưu timing, latency và tài nguyên | Đang thực hiện\n",
      "rows": 7,
      "cols": 3,
      "cells": [
        {
          "index": 1,
          "row": 1,
          "column": 1,
          "position": {
            "left": 142.12,
            "top": 273.19,
            "width": 429.38,
            "height": 67.61
          },
          "text": "Công việc",
          "fillColor": "#F2F2F2",
          "style": {
            "fontSize": 40,
            "typeface": "Times New Roman",
            "color": "#000000",
            "bold": true,
            "alignment": "center"
