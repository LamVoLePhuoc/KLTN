bold":true,"alignment":"center"}},{"id":"sh/q143ylov","kind":"shape","position":{"left":914,"top":210,"width":288,"height":172}},{"id":"sh/r2dkrq5g","kind":"textbox","text":"Ranh giới hệ thống","position":{"left":940,"top":230,"width":236,"height":34},"style":{"fontSize":20,"typeface":"Arial","color":"#1F6FEB","bold":true,"alignment":"center"}},{"id":"sh/s3ml0v61","kind":"textbox","text":"AR/R + AW/W/B\nBackpressure an toàn\nCPU và DMA master","position":{"left":940,"top":278,"width":236,"height":82},"style":{"fontSize":18,"typeface":"Arial","color":"#132231","alignment":"center"}},{"id":"sh/d4f2t0nm","kind":"shape","position":{"left":566,"top":424,"width":636,"height":178}},{"id":"sh/e5o32lor","kind":"textbox","text":"Full Block Design synthesis PASS","position":{"left":598,"top":446,"width":572,"height":38},"style":{"fontSize":24,"typeface":"Arial","color":"#FFFFFF","bold":true,"alignment":"center"}},{"id":"sh/f6xkvq5c","kind":"textbox","text":"LUT 71,81%     FF 22,86%     BRAM 93,58%     DSP 12%","position":{"left":598,"top":500,"width":572,"height":34},"style":{"fontSize":20,"typeface":"Arial","color":"#8DE7EC","bold":true,"alignment":"center"}},{"id":"sh/p0zmlk7u","kind":"textbox","text":"Timing 100 MHz chưa đạt: WNS = −5,308 ns","position":{"left":598,"top":552,"width":572,"height":30},"style":{"fontSize":19,"typeface":"Arial","color":"#FFC273","bold":true,"alignment":"center"}}],"notes":{"text":"L2 ban đầu dùng một mảng bất đồng bộ 4.194.304 bit. Vivado không thể xử lý biến lớn như vậy và synthesis kéo dài nhiều giờ. Phiên bản mới chia dữ liệu thành tám bank 32 bit, dùng truy cập đồng bộ và scrub sau reset. Kết quả là full Block Design synthesis sạch. Tài nguyên gần nhất cho thấy LUT khoảng 71,81 phần trăm, register 22,86 phần trăm, BRAM 93,58 phần trăm và DSP 12 phần trăm. BRAM hiện là giới hạn chính. Timing 100 MHz vẫn chưa đạt, với WNS âm 5,308 nano giây.\n\nAHB-Lite và AXI4 đều đã có, nhưng đảm nhiệm hai ranh giới khác nhau. AHB-Lite phục vụ đường L1 đến cache controller, giữ HREADY, HRESP, HSIZE, HPROT và HMASTLOCK. AXI4 wrapper đưa CPU memory port ra miền hệ thống, giữ VALID và payload qua backpressure, đồng thời bắt tay AW và W độc lập. DMA cũng đã có AXI4 master và AXI4-Lite register file, nhưng chưa được ghép vào AXI interconnect của Block Design.\n\nNguồn nội bộ:\n- Risc_V_new/README.md\n- Risc_V_new/Risc_V/rtl/cache/l2_cache.v\n- Risc_V_new/Risc_V/docs/architecture/bus_domains.png"}}
