l","color":"#19B5C5","bold":true,"alignment":"center"}},{"id":"sh/atwbelcn","kind":"textbox","text":"Board test","position":{"left":176,"top":510,"width":270,"height":34},"style":{"fontSize":22,"typeface":"Arial","color":"#071A2B","bold":true,"alignment":"left"}},{"id":"sh/lk7ut0va","kind":"textbox","text":"Bitstream, DDR thật và workload CPU–DMA","position":{"left":176,"top":544,"width":660,"height":32},"style":{"fontSize":18,"typeface":"Arial","color":"#586B7C","alignment":"left"}},{"id":"sh/kjytkvup","kind":"shape","position":{"left":858,"top":536,"width":310,"height":4}},{"id":"sh/jypcrqd4","kind":"shape","position":{"left":850,"top":190,"width":332,"height":304}},{"id":"sh/yxgbilcj","kind":"textbox","text":"Mốc hoàn tất mong muốn","position":{"left":878,"top":220,"width":276,"height":32},"style":{"fontSize":21,"typeface":"Arial","color":"#FFFFFF","bold":true,"alignment":"center"}},{"id":"sh/1o3ahwvq","kind":"textbox","text":"CPU tạo dữ liệu nguồn\nDMA copy qua DDR\nCPU kiểm tra dữ liệu đích","position":{"left":878,"top":286,"width":276,"height":110},"style":{"fontSize":22.8,"typeface":"Arial","color":"#8DE7EC","bold":true,"alignment":"center"}},{"id":"sh/0nut8rul","kind":"textbox","text":"Có log PASS và báo cáo timing sau implementation","position":{"left":878,"top":424,"width":276,"height":48},"style":{"fontSize":17,"typeface":"Arial","color":"#FFC273","bold":true,"alignment":"center"}},{"id":"sh/q9srixs3","kind":"textbox","text":"Kết luận tuần này: chức năng DMA đã PASS độc lập; công việc còn lại tập trung vào tích hợp và timing.","position":{"left":122,"top":620,"width":1036,"height":42},"style":{"fontSize":21,"typeface":"Arial","color":"#071A2B","bold":true,"alignment":"center"}}],"notes":{"text":"Bước tiếp theo của em gồm năm mốc. Đầu tiên em tích hợp DMA vào AXI interconnect và cấp vùng địa chỉ AXI4-Lite. Sau đó em xác nhận cache handshake và clock domain. Em sẽ chạy synthesis lại vì BRAM đã dùng hơn chín mươi ba phần trăm. Tiếp theo là xử lý critical path để đạt timing. Mốc cuối là bitstream và workload CPU tạo dữ liệu nguồn, DMA copy qua DDR, rồi CPU kiểm tra dữ liệu đích. Trong tuần này em chỉ kết luận DMA đã PASS độc lập ở RTL, chưa kết luận toàn SoC đã hoàn thành.\n\nNguồn nội bộ:\n- Risc_V_new/README.md\n- Risc_V_new/Risc_V/docs/BOOT_DMA_PROTOCOL.md"}}