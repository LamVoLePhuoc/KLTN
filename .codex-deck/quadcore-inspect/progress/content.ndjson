on":{"left":84,"top":482,"width":166,"height":44},"style":{"fontSize":18,"typeface":"Arial","color":"#FFFFFF","bold":true,"alignment":"center"}},{"id":"sh/5sne5wne","kind":"textbox","text":"›","position":{"left":264,"top":482,"width":42,"height":44},"style":{"fontSize":34,"typeface":"Arial","color":"#F28C28","bold":true,"alignment":"center"}},{"id":"sh/kredcr6t","kind":"shape","position":{"left":310,"top":472,"width":190,"height":66}},{"id":"sh/jq5w365o","kind":"textbox","text":"Pre-flush","position":{"left":322,"top":482,"width":166,"height":44},"style":{"fontSize":18,"typeface":"Arial","color":"#FFFFFF","bold":true,"alignment":"center"}},{"id":"sh/i5wva1o3","kind":"textbox","text":"›","position":{"left":502,"top":482,"width":42,"height":44},"style":{"fontSize":34,"typeface":"Arial","color":"#F28C28","bold":true,"alignment":"center"}},{"id":"sh/x4ne1wni","kind":"shape","position":{"left":548,"top":472,"width":190,"height":66}},{"id":"sh/w3ed8r6x","kind":"textbox","text":"DMA copy","position":{"left":560,"top":482,"width":166,"height":44},"style":{"fontSize":18,"typeface":"Arial","color":"#FFFFFF","bold":true,"alignment":"center"}},{"id":"sh/m9sb2x4v","kind":"textbox","text":"›","position":{"left":740,"top":482,"width":42,"height":44},"style":{"fontSize":34,"typeface":"Arial","color":"#F28C28","bold":true,"alignment":"center"}},{"id":"sh/na1sb2lg","kind":"shape","position":{"left":786,"top":472,"width":190,"height":66}},{"id":"sh/8bat47ml","kind":"textbox","text":"Post-flush","position":{"left":798,"top":482,"width":166,"height":44},"style":{"fontSize":18,"typeface":"Arial","color":"#FFFFFF","bold":true,"alignment":"center"}},{"id":"sh/9w3uds36","kind":"textbox","text":"›","position":{"left":978,"top":482,"width":42,"height":44},"style":{"fontSize":34,"typeface":"Arial","color":"#F28C28","bold":true,"alignment":"center"}},{"id":"sh/y5sbed4j","kind":"shape","position":{"left":1024,"top":472,"width":190,"height":66}},{"id":"sh/z61s7il4","kind":"textbox","text":"DONE / ERROR","position":{"left":1036,"top":482,"width":166,"height":44},"style":{"fontSize":18,"typeface":"Arial","color":"#FFFFFF","bold":true,"alignment":"center"}},{"id":"sh/07atgnmp","kind":"textbox","text":"DMA không phải MSI snoop master. Phần mềm vẫn phải quản lý quyền sở hữu buffer.","position":{"left":132,"top":588,"width":1016,"height":44},"style":{"fontSize":19,"typeface":"Arial","color":"#D84B4B","bold":true,"alignment":"center"}}],"notes":{"text":"DMA mới gồm register file AXI4-Lite, cache coordinator và AXI4 memcpy engine. Phần mềm ghi source, destination, length và start. Coordinator chỉ nhận lệnh khi buffer_quiesced đã lên, chạy pre-maintenance, sau đó cho DMA copy và cuối cùng chạy post-maintenance. Burst không vượt biên 4 KiB. Read error chặn write tương ứng, còn write response error vẫn yêu cầu post-maintenance. Watchdog vừa được sửa để đo thời gian không có tiến triển, thay vì giới hạn tổng thời gian của một lệnh nhiều burst.\n\nNguồn nội bộ:\n- Risc_V_new/Risc_V/rtl/dma/README.md\n- Risc_V_new/Risc_V/rtl/dma/soc_dma_controller.v\n- Risc_V_new/Risc_V/docs/BOOT_DMA_PROTOCOL.md"}}
{"id":"sl/udsvah03","index":8,"layout":{"id":"ly/14ra9krq","name":"Blank"},"title":"KẾT QUẢ","elements":[{"id":"sh/bih4na5w","kind":"shape","position":{"left":0,"top":0,"width":1280,"height":14}},{"id":"sh/1cfmhgne","kind":"textbox","text":"KẾT QUẢ","position":{"left":68,"top":38,"width":360,"height":24},"style":{"fontSize":13,"typeface":"Arial","color":"#0B8F87","bold":true,"alignment":"left"}},{"id":"sh/0b65obm9","kind":"textbox","text":"Bằng chứng kiểm chứng hiện có","position":{"left":68,"top":70,"width":1120,"height":52},"style":{"fontSize":34,"typeface":"Arial","color":"#071A2B","bold":true,"alignment":"left"}},{"id":"sh/nex4jq5k","kind":"shape","position":{"left":68,"top":128,"width":92,"height":5}},{"id":"sh/mdonql4z","kind":"textbox","text":"09","position":{"left":1170,"top":668,"width":42,"height":22},"style":{"fontSize":12,"typeface":"Arial","color":"#586B7C","bold":true,"alignment":"right"}},{"id":"tb/g7uhcbqt","kind":"table","text":"Nhóm\tKết quả\tPhạm vi chứng minh\nMMU trên Vivado XSIM\t9/9 PASS\tSv32, TLB/PTW, context, bus fault\nRegression nền\t26/26 PASS\tMMU, CSR, cache, coherence, bus\nDMA end-to-end\tPASS\tAXI-Lite, burst copy, flush, error, watchdog\nFull Block Design\tSynthesis PASS\t0 error, 0 critical warning\nTiming 100 MHz\tCHƯA ĐẠT\tWNS −5,308 ns\nFPGA end-to-end\tCHƯA CHẠY\tDMA chưa tích hợp với DDR thật","position":{"left":76,"top":174,"width":1128,"height":402}},{"id":"sh/ofq5svm5","kind":"textbox","text":"Không cộng các nhóm test thành một con số duy nhất vì chúng thuộc các mốc source khác nhau.","position":{"left":118,"top":606,"width":1044,"height":42},"style":{"fontSize":18,"typeface":"Arial","color":"#586B7C","alignment":"center"}}],"notes":{"text":"Kết quả hiện tại gồm chín trên chín test MMU chạy PASS trên Vivado XSIM, regression nền hai mươi sáu trên hai mươi sáu PASS, và DMA end-to-end PASS. Full Block Design nền cũng synthesis thành công. Tuy nhiên em chưa tuyên bố DMA đã hoàn thành ở mức SoC hoặc FPGA, vì DMA chưa vào AXI fabric của Block Design và chưa chạy với DDR thật. Bước tiếp theo là tích hợp DMA master và AXI-Lite slave, xác nhận address map và clock domain, chạy synthesis lại, sau đó xử lý timing trước khi tạo bitstream và thử trên board.\n\nNguồn nội bộ:\n- Risc_V_new/Risc_V/reports/xsim-mmu-20260927-162006/summary.md\n- Risc_V_new/Risc_V/reports/full-regression-latest/summary.md\n- Risc_V_new/Risc_V/sim/tb_dma_end_to_end.v\n- Risc_V_new/README.md"}}
