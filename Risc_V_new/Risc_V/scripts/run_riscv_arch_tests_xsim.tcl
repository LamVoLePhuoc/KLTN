# Run every self-checking ACT4 ELF in a directory on the full cached quad-core
# hierarchy. Usage:
#   vivado -mode batch -source scripts/run_riscv_arch_tests_xsim.tcl \
#       -tclargs <act4-elf-directory> ?<test-glob>?

if {$argc < 1 || $argc > 2} {
    error "Usage: run_riscv_arch_tests_xsim.tcl <elf-directory> ?<test-glob>?"
}
set script_dir  [file dirname [file normalize [info script]]]
set project_dir [file normalize [file join $script_dir ..]]
set rtl_dir     [file join $project_dir rtl]
set sim_dir     [file join $project_dir sim]
set elf_dir     [file normalize [lindex $argv 0]]
set test_glob   [expr {$argc == 2 ? [lindex $argv 1] : "*"}]
set objcopy     [file join $project_dir .tools xpack-riscv-none-elf-gcc-15.2.0-1 bin riscv-none-elf-objcopy.exe]
if {![file isdirectory $elf_dir]} { error "ACT4 ELF directory not found: $elf_dir" }
if {![file exists $objcopy]} { error "RISC-V objcopy not found: $objcopy" }
proc collect_elfs {dir} {
    set found {}
    foreach path [glob -nocomplain -directory $dir *] {
        if {[file isdirectory $path]} {
            set found [concat $found [collect_elfs $path]]
        } elseif {[string equal -nocase [file extension $path] ".elf"]} {
            lappend found $path
        }
    }
    return $found
}
set all_elfs [lsort [collect_elfs $elf_dir]]
set elfs {}
foreach elf $all_elfs {
    if {[string match -nocase $test_glob [file rootname [file tail $elf]]]} {
        lappend elfs $elf
    }
}
if {[llength $elfs] == 0} {
    error "No ACT4 ELF files in $elf_dir matched '$test_glob'"
}

set stamp [clock format [clock seconds] -format "%Y%m%d-%H%M%S"]
set report_dir [file join $project_dir reports "xsim-riscv-arch-test-$stamp"]
file mkdir $report_dir
set rtl_files {}
set manifest [open [file join $rtl_dir files.f] r]
while {[gets $manifest line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string index $line 0] eq "#"} { continue }
    lappend rtl_files [file normalize [file join $rtl_dir $line]]
}
close $manifest

set old_dir [pwd]
cd $report_dir
if {[catch {exec xvlog -work xil_defaultlib {*}$rtl_files} output]} {
    cd $old_dir; error "RTL compile failed: $output"
}
set tb_xvlog_args [list -work xil_defaultlib [file join $sim_dir tb_riscv_arch_test.v]]
if {[catch {exec xvlog {*}$tb_xvlog_args} output]} {
    cd $old_dir; error "ACT testbench compile failed: $output"
}
set snapshot tb_riscv_arch_test_behav
if {[catch {exec xelab -debug off -mt off xil_defaultlib.tb_riscv_arch_test -snapshot $snapshot} output]} {
    cd $old_dir; error "ACT testbench elaboration failed: $output"
}

set pass_count 0
set results {}
foreach elf $elfs {
    set name [file rootname [file tail $elf]]
    set image [file join $report_dir arch_test.mem]
    if {[catch {exec $objcopy -O verilog --verilog-data-width=4 $elf $image} output]} {
        lappend results [list $name TOOL_ERROR]
        continue
    }
    catch {exec xsim $snapshot -R} run_output
    set log [open [file join $report_dir "run-${name}.log"] w]
    puts $log $run_output
    close $log
    set status FAIL
    if {[string first "RISCV_ARCH_TEST_TB: PASS" $run_output] >= 0 &&
        [string first "RISCV_ARCH_TEST_TB: FAIL" $run_output] < 0} {
        set status PASS
        incr pass_count
    }
    lappend results [list $name $status]
    puts [format "%-64s %s" $name $status]
}

set summary_path [file join $report_dir summary.md]
set summary [open $summary_path w]
puts $summary "# RISC-V self-checking ELF execution"
puts $summary ""
puts $summary "- Result: $pass_count/[llength $elfs] PASS"
puts $summary "- Scope: self-checking ELFs supplied from `$elf_dir`"
puts $summary "- Harness: hart 0 under the full L1/AHB/coherence/L2/AXI hierarchy; harts 1-3 parked"
puts $summary ""
puts $summary "| Test | Result |"
puts $summary "|---|---:|"
foreach result $results { lassign $result name status; puts $summary "| $name | $status |" }
puts $summary ""
puts $summary "> ACT certification tests do not replace supplemental RTL, protocol, coherence and workload verification."
puts $summary "> Count this as an official ACT4 result only when the supplied ELFs were generated by the pinned ACT4 flow."
close $summary
cd $old_dir
puts "RISCV_ARCH_TEST_RESULT $pass_count/[llength $elfs] PASS"
puts "Evidence: $summary_path"
if {$pass_count != [llength $elfs]} { error "One or more ACT4 ELFs failed" }
